{
  "name": "smolcoder",
  "version": "0.7.1",
  "description": "A smol, zero-config CLI coding agent for local models (Ollama & LM Studio). It just works.",
  "keywords": [
    "cli",
    "coding-agent",
    "agent",
    "ollama",
    "lm-studio",
    "local-llm",
    "local-models",
    "smol",
    "ai"
  ],
  "license": "MIT",
  "author": "Leon van Zyl",
  "homepage": "https://github.com/leonvanzyl/smolcoder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonvanzyl/smolcoder.git"
  },
  "bugs": {
    "url": "https://github.com/leonvanzyl/smolcoder/issues"
  },
  "bin": {
    "smol": "dist/index.js",
    "smolcoder": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc -w",
    "prepublishOnly": "npm test",
    "test": "npm run build && node scripts/test.cjs",
    "lint": "biome check --write src test scripts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.cjs\"",
    "typecheck": "tsc --noEmit",
    "qa": "npm run typecheck && npm run lint && npm run format:check",
    "package-win": "npm run build && electron-packager . Smolcoder --platform=win32 --arch=x64 --out=release --overwrite && node scripts/patch-packaged-main.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^20.14.0",
    "electron": "^31.7.7",
    "electron-packager": "^17.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "undici-types": "^6.21.0"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
